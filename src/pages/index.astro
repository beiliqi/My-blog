---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../config';
import { getPosts, collectTags } from '../lib/posts';

const posts = await getPosts();
const tags = collectTags(posts).slice(0, 8);
const visible = posts.slice(0, 30);
---

<BaseLayout
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: SITE.title,
    description: SITE.description,
    author: { '@type': 'Person', name: SITE.author },
  }}
>
  <section class="hero">
    <div class="container">
      <p class="hero__eyebrow">{SITE.title} / Notebook</p>
      <h1>{SITE.tagline}</h1>
      <p>{SITE.description}</p>
      <div class="hero__meta">
        <span>{posts.length} 篇文章</span>
        <span>
          <a href="/archive">按时间归档</a>
        </span>
        <span>
          <a href="/rss.xml">RSS 订阅</a>
        </span>
      </div>
    </div>
  </section>

  <div class="container">
    <h2 class="section-label">最新文章</h2>
    <PostList posts={visible} />

    {posts.length > visible.length && (
      <p class="empty-state">
        还有 {posts.length - visible.length} 篇，去 <a href="/archive">归档</a> 里看全部。
      </p>
    )}

    {tags.length > 0 && (
      <>
        <h2 class="section-label">常写的话题</h2>
        <ul class="tag-cloud">
          {tags.map((tag) => (
            <li>
              <a href={`/tags/${encodeURIComponent(tag.name)}`}>
                {tag.name}
                <b>{tag.count}</b>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </div>
</BaseLayout>
