---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="这个地址没有对应的内容" noindex>
  <div class="container">
    <header class="page-head">
      <h1>404</h1>
      <p>这个地址没有对应的内容，可能是链接过期了。</p>
    </header>
    <p class="empty-state">
      回到<a href="/">首页</a>，或者去<a href="/archive">归档</a>里找找。
    </p>
  </div>
</BaseLayout>
