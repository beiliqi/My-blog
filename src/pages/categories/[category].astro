---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, collectCategories } from '../../lib/posts';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getPosts();
  return collectCategories(posts).map((category) => ({
    params: { category: category.name },
    props: {
      name: category.name,
      posts: posts.filter((post) => post.data.category === category.name),
    },
  }));
}

const { name, posts } = Astro.props;
---

<BaseLayout title={`分类：${name}`} description={`分类 ${name} 下的全部文章`}>
  <div class="container">
    <header class="page-head">
      <h1>分类：{name}</h1>
      <p>{posts.length} 篇文章 · <a href={withBase('/categories/')}>全部分类</a></p>
    </header>
    <PostList posts={posts} />
  </div>
</BaseLayout>
