---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, collectTags } from '../../lib/posts';
import { withBase } from '../../lib/url';

const posts = await getPosts();
const tags = collectTags(posts);
---

<BaseLayout title="标签" description="按标签浏览全部文章">
  <div class="container">
    <header class="page-head">
      <h1>标签</h1>
      <p>共 {tags.length} 个标签，{posts.length} 篇文章</p>
    </header>

    <ul class="tag-cloud">
      {tags.map((tag) => (
        <li>
          <a href={withBase(`/tags/${encodeURIComponent(tag.name)}`)}>
            {tag.name}
            <b>{tag.count}</b>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
