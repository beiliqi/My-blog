---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';

const entry = await getEntry('pages', 'about');
if (!entry) {
  throw new Error('缺少 src/content/pages/about.md');
}
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description || SITE.description}>
  <article class="post container">
    <header class="post__header">
      <h1 class="post__title">{entry.data.title}</h1>
      {entry.data.description && <p class="post__lead">{entry.data.description}</p>}
    </header>
    <div class="post__content">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
